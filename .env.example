# Copy to .env for local runs. Never commit .env. On Vercel, set these in Project Settings > Environment Variables.

# Live AI mode. Leave empty to run the built-in simulation (no AI calls, no cost).
ANTHROPIC_API_KEY=

# "mock" forces simulation even if a key is set. "live" forces live AI (for local runs using an `ant` profile).
DEMO_MODE=

# Optional. If set, every /api call must send this code in the x-demo-code header (the demo page asks for it).
DEMO_ACCESS_CODE=

# Models (defaults match the unit-economics model in the plan docs).
DEMO_PERSONA_MODEL=claude-haiku-5-5
DEMO_SCORER_MODEL=claude-sonnet-5-5

# Requests allowed per IP per 10 minutes (best-effort, per serverless instance).
DEMO_RATE_MAX=30
